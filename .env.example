# ── Webflow ───────────────────────────────────────────────────────────────
# Jeton d'API Webflow (Site token) : Webflow > Site settings > Apps & integrations
# > API access > Generate API token.  Portées nécessaires : cms:read, cms:write,
# sites:read, assets:read, assets:write.
WEBFLOW_TOKEN=

# ── Claude (lecture automatique de la fiche PDF) ──────────────────────────
# Clé API Anthropic : https://console.anthropic.com/settings/keys
# Sans cette clé, l'outil fonctionne quand même mais il faut saisir les
# informations à la main dans l'écran de relecture.
ANTHROPIC_API_KEY=

# Si votre clé n'est rattachée à aucun espace de travail, l'API répond 400 et
# demande cet en-tête. Deux solutions : créer une clé depuis un espace de
# travail dans la console Anthropic, ou renseigner l'identifiant ici.
# ANTHROPIC_WORKSPACE_ID=

# ── Accès ─────────────────────────────────────────────────────────────────
# Mot de passe d'entrée du site. Obligatoire dès que l'outil est en ligne :
# sans lui, toute personne connaissant l'adresse pourrait publier sur le site
# de l'étude. Visez 16 caractères ou plus.
# En local, vous pouvez le laisser vide.
MOT_DE_PASSE=

# Port du serveur local (interface glisser-déposer)
PORT=4000

# ── Réglages ──────────────────────────────────────────────────────────────
# En local, « npm run setup » les écrit dans config/config.json et vous n'avez
# rien à mettre ici. En ligne (Vercel), le disque est en lecture seule : ces
# variables prennent le relais. « npm run vercel » affiche les valeurs à copier.
# WEBFLOW_SITE_ID=
# WEBFLOW_SITE_NOM=
# WEBFLOW_COLLECTION_ID=
# WEBFLOW_COLLECTION_NOM=
# WEBFLOW_CHAMP_IMAGE=
# WEBFLOW_CHAMP_GALERIE=
# WEBFLOW_CHAMP_FICHE_PDF=
# CONSIGNES=
# PHOTO_LARGEUR_MAX=2400
# PHOTO_QUALITE=82
